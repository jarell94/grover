# Grover Frontend - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables must be prefixed with EXPO_PUBLIC_ to be accessible at runtime
# in Expo / React Native builds.
#
# NEVER commit .env to source control.

# ── Backend API ────────────────────────────────────────────────────────────────
# URL of the Grover backend server.
# For local development this points to the backend running on your machine.
# The port must match the uvicorn port in backend/server.py (default: 8001).
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# ── Agora (live streaming) ─────────────────────────────────────────────────────
# Must match AGORA_APP_ID in backend/.env
# Sign up at https://console.agora.io – free tier supports development
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id

# ── Sentry (error tracking – optional) ────────────────────────────────────────
# Leave blank to disable Sentry in development
EXPO_PUBLIC_SENTRY_DSN=

# ── Environment ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_ENVIRONMENT=development
