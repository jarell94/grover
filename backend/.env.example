# Grover Backend - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to source control.

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Local dev: start MongoDB with `docker run -p 27017:27017 mongo`
MONGO_URL=mongodb://localhost:27017
DB_NAME=grover_dev

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=1.0.0

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001,http://localhost:19006

# ── Authentication ─────────────────────────────────────────────────────────────
# URL of the Emergent auth backend (handles Google OAuth)
AUTH_BACKEND_URL=https://demobackend.emergentagent.com

# ── Redis (optional – caching) ─────────────────────────────────────────────────
# Local dev: start Redis with `docker run -p 6379:6379 redis`
# Leave blank to disable caching in development
REDIS_URL=redis://localhost:6379

# ── Cloudinary (media storage) ─────────────────────────────────────────────────
# Sign up at https://cloudinary.com – free tier is sufficient for development
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── AWS S3 (alternative media storage – optional) ──────────────────────────────
# Leave blank to use Cloudinary instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# ── PayPal (payments) ──────────────────────────────────────────────────────────
# Use sandbox credentials for development: https://developer.paypal.com
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-sandbox-paypal-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-paypal-client-secret
PAYPAL_RETURN_URL=http://localhost:3000/payment/success
PAYPAL_CANCEL_URL=http://localhost:3000/payment/cancel

# ── Agora (live streaming) ─────────────────────────────────────────────────────
# Sign up at https://console.agora.io – free tier supports development
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# ── Sentry (error tracking – optional) ────────────────────────────────────────
# Leave blank to disable Sentry in development
SENTRY_DSN=
